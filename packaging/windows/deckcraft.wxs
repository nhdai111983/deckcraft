<?xml version="1.0" encoding="utf-8"?>
<!--
  Nexus Slides MSI (NexusOffices, by Sonnytech; based on DeckCraft). WiX Toolset v5:
  `dotnet tool install -g wix`. Built by package.ps1:

    wix build deckcraft.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files\Nexus Slides, a Start Menu shortcut, and Nexus Slides
  offered under "Open with" for .deckcraft/.pptx/.potx/.ppsx without taking over the user's
  default app for them. Unlike upstream, it does not own .deckcraft (see the ProgId below), so it
  coexists with an installed copy of upstream's app.

  UpgradeCode and the component GUID below belong to Nexus Slides alone (generated 2026-10-17;
  never change them, or upgrades install side by side). Never copy them from (or into) upstream
  or a sibling app: Windows Installer treats every package sharing an UpgradeCode as one product
  and would remove the other app. Registry keys, ProgIds and the install folder are Nexus Slides'
  own too, so it installs and uninstalls next to upstream's app without touching it.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Nexus Slides"
      Manufacturer="Sonnytech"
      Version="$(var.Version)"
      UpgradeCode="96D068F9-30CC-4E22-808D-242613C1E158"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Nexus Slides presentations and slide shows" Manufacturer="Sonnytech" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Nexus Slides is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="DeckcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="DeckcraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/nhdai111983/deckcraft" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Nexus Slides" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Nexus Slides" Level="1">
      <ComponentGroupRef Id="DeckcraftFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="DeckcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="DeckcraftApp" Guid="F3911F7B-4F9F-4BA6-8D06-B513AB237AF1">
        <File Id="DeckcraftExe" Source="$(var.BinDir)\deckcraft.exe" Name="nexus-slides.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Nexus Slides"
              Description="Nexus Slides presentations and slide shows" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="DeckcraftIcon.ico" IconIndex="0" />
        </File>

        <!-- ProgId: how Explorer opens a file with Nexus Slides. Written as plain registry values,
             not a WiX <ProgId><Extension>, because that would make Nexus Slides the owner of
             .deckcraft: upstream's app owns the same extension (its own ProgId), and
             installing would overwrite HKCR\.deckcraft's default value and Content Type while
             uninstalling would delete them, breaking upstream's installed app. Nexus Slides never
             writes .deckcraft's default value or Content Type; the extension and the
             application/x-deckcraft MIME type stay the shared file-format identifiers. -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Sonnytech.NexusSlides.Presentation" Value="Nexus Slides Presentation" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Sonnytech.NexusSlides.Presentation\DefaultIcon" Value="&quot;[#DeckcraftExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Sonnytech.NexusSlides.Presentation\shell\open\command" Value="&quot;[#DeckcraftExe]&quot; &quot;%1&quot;" Type="string" />

        <!-- "Open with" for .deckcraft and the PowerPoint formats, without becoming the default
             (only a named value under OpenWithProgids; uninstall removes just that value). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\.deckcraft\OpenWithProgids" Name="Sonnytech.NexusSlides.Presentation" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\nexus-slides.exe" Name="FriendlyAppName" Value="Nexus Slides" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\nexus-slides.exe\shell\open\command" Value="&quot;[#DeckcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\nexus-slides.exe\SupportedTypes" Name=".deckcraft" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\nexus-slides.exe\SupportedTypes" Name=".pptx" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\nexus-slides.exe\SupportedTypes" Name=".potx" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\nexus-slides.exe\SupportedTypes" Name=".ppsx" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.pptx\OpenWithProgids" Name="Sonnytech.NexusSlides.Presentation" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.potx\OpenWithProgids" Name="Sonnytech.NexusSlides.Presentation" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.ppsx\OpenWithProgids" Name="Sonnytech.NexusSlides.Presentation" Value="" Type="string" />

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\nexus-slides.exe" Value="[#DeckcraftExe]" Type="string" />
      </Component>

      <Component Id="DeckcraftCli">
        <File Id="DeckcraftCliExe" Source="$(var.BinDir)\deckcraft-cli.exe" Name="nexus-slides-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
